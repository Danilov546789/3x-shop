# ---- Telegram ----
BOT_TOKEN=123456:ABC-your-telegram-bot-token
ADMIN_IDS=123456789

# Домен сайта (нужен домен с HTTPS). На корне ("/") — публичный веб-магазин,
# Mini App теперь открывается на WEBAPP_URL + "/tgapp" (это и укажите в BotFather),
# админка — на WEBAPP_URL + "/admin". Для теста можно поднять через ngrok/cloudflared.
WEBAPP_URL=https://your-domain.example.com
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8000

# ---- Веб-админка (доступна на WEBAPP_URL/admin) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Сгенерируйте случайную строку: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-too-please

# ---- 3x-ui: панели теперь настраиваются через админку (/admin -> Серверы) и хранятся в БД.
# Проект умеет управлять НЕСКОЛЬКИМИ панелями сразу (см. README -> "Несколько панелей 3x-ui").
# Переменные ниже — только "бутстрап" первой панели: если при первом запуске в БД ещё нет
# ни одной панели, из этих переменных будет создана одна (можно оставить пустыми и добавить
# панель прямо в админке).
XUI_BASE_URL=https://your-panel.example.com:2053
# Возьмите в панели: Settings -> Security -> API Token
XUI_API_TOKEN=your-api-token-here
# ID инбаундов (через запятую), в которые будет добавляться каждый новый клиент на этой панели.
XUI_INBOUND_IDS=1,2,3
# Базовый URL встроенного Subscription-сервиса 3x-ui (Settings -> Subscription Settings)
# Пример: https://your-panel.example.com:2096/sub
XUI_SUB_BASE_URL=https://your-panel.example.com:2096/sub
# Необязательно: дополнительные внешние ссылки-подписки, которые нужно подмешать в подписку
# КАЖДОГО клиента на ГЛАВНОЙ панели (аналог вкладки "Ссылки" -> "Добавить внешнюю подписку").
# JSON-массив объектов {"url": "...", "name_prefix": "..."}.
# name_prefix подставляется перед именем каждого сервера из внешней подписки
# (в примере на скриншоте это даёт записи вида "LTE The Netherlands — #64").
XUI_EXTERNAL_SUBSCRIPTIONS=[{"url":"https://raw.githubusercontent.com/example/sub/refs/heads/main/vless","name_prefix":"LTE "}]
# Flow, включаемый у каждого клиента при создании/продлении (для VLESS+TLS/Reality инбаундов).
XUI_CLIENT_FLOW=xtls-rprx-vision

# ---- DB ----
DATABASE_URL=sqlite+aiosqlite:///./vpnshop.db

# ---- Payments ----
# Telegram Stars работает всегда "из коробки" и не требует настройки.
# Чтобы дополнительно включить оплату картой через ЮKassa — заполните оба поля ниже
# (найти в личном кабинете ЮKassa: Настройки -> Магазины -> API).
# Если оставить пустыми, в Mini App будет доступна только оплата Stars.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Необязательно: страница, куда вернётся пользователь после оплаты картой.
# Если не задано, используется webapp/static/payment-return.html на вашем домене.
YOOKASSA_RETURN_URL=

# ---- Уведомления об истечении подписки ----
# За сколько дней до истечения слать напоминания (через запятую, по убыванию)
NOTIFY_DAYS_BEFORE=3,1
# Как часто (в минутах) бот проверяет подписки в фоне
NOTIFY_CHECK_INTERVAL_MINUTES=60

# ---- Пробный период ----
TRIAL_ENABLED=true
TRIAL_DAYS=1
TRIAL_DATA_LIMIT_GB=0

# ---- Обязательная подписка на канал ----
# Оставьте пустым, чтобы отключить проверку. Бот должен быть добавлен в канал
# (участником, а для приватных каналов — лучше администратором), иначе проверка
# не сможет получить статус пользователя.
REQUIRED_CHANNEL_ID=
REQUIRED_CHANNEL_URL=https://t.me/your_channel

# ---- Приложения для использования подписки (показываются в боте и Mini App) ----
APP_LINK_IOS=https://www.happ.su/main/ru
APP_LINK_ANDROID=https://www.happ.su/main/ru
APP_LINK_MACOS=https://www.happ.su/main/ru
APP_LINK_WINDOWS=https://github.com/2dust/v2rayN/releases/download/7.24.9/v2rayN-windows-64.zip
APP_LINK_LINUX=https://github.com/2dust/v2rayN/releases

# ---- Публичный веб-магазин на корне домена (без Telegram, оплата картой) ----
SHOP_ENABLED=true
SHOP_TITLE=VPN Shop
# Ссылка на бота, показывается на сайте кнопкой "Открыть в Telegram" (необязательно)
SHOP_BOT_URL=https://t.me/your_bot
